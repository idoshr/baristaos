[Unit]
Description=BaristaOS monitor
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
# Point these at the checkout and the interpreter that has the deps.
WorkingDirectory=/opt/baristaos
EnvironmentFile=-/etc/baristaos.env
ExecStart=/usr/bin/python3 /opt/baristaos/main.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
